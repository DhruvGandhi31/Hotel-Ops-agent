# Copy to .env (or run ./scripts/init-env.sh to copy with generated secrets).
# Placeholder values work for CI and throwaway local runs only.

# --- Postgres superuser (used only for first-time init) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST_PORT=5433

# --- n8n internals database (db: n8n) ---
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-n8n

# --- App database (db: ops). Also the role n8n's Postgres credential uses. ---
OPS_DB_USER=ops_app
OPS_DB_PASSWORD=change-me-ops

# --- n8n ---
# Encrypts stored credentials. Changing it later makes existing credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-encryption-key
N8N_HOST_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=Australia/Sydney
# Instance-level MCP server at /mcp-server/http (n8n >= 2.20.0).
N8N_MCP_ACCESS_ENABLED=false
# Execution history retention, in hours.
EXECUTIONS_DATA_MAX_AGE=336

# --- Ollama (compose profile: local-llm) ---
OLLAMA_HOST_PORT=11435
