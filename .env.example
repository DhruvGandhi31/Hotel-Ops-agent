# Copy to .env (or run ./scripts/init-env.sh to copy with generated secrets).
# Placeholder values work for CI and throwaway local runs only.

# --- Postgres superuser (used only for first-time init) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST_PORT=5433

# --- n8n internals database (db: n8n) ---
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-n8n

# --- App database (db: ops). Also the role n8n's Postgres credential uses. ---
OPS_DB_USER=ops_app
OPS_DB_PASSWORD=change-me-ops

# --- n8n ---
# Encrypts stored credentials. Changing it later makes existing credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-encryption-key
N8N_HOST_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=Australia/Sydney
# Instance-level MCP server at /mcp-server/http (n8n >= 2.20.0).
N8N_MCP_ACCESS_ENABLED=false
# Execution history retention, in hours.
EXECUTIONS_DATA_MAX_AGE=336

# --- Invoice upload webhook ---
# Callers send this in the X-Ingest-Token header. Used by scripts/setup-credentials.sh.
INGEST_WEBHOOK_TOKEN=change-me-ingest-token

# --- Ollama ---
# Where n8n reaches Ollama. Default: Ollama running natively on the Docker host.
# For the compose profile use http://ollama:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Host port for the compose-profile Ollama (compose profile: local-llm)
OLLAMA_HOST_PORT=11435

# --- n8n owner account (scripts/setup-owner.sh) ---
# The Approval Form signs approvers in with n8n accounts and records the signed-in account as the approver.
# 8-64 characters with a digit and an upper-case letter. init-env.sh generates the password.
N8N_OWNER_EMAIL=owner@example.com
N8N_OWNER_PASSWORD=Change-me-owner-1
