      "parameters": {
        "jsCode": "// The webhook body must be JSON with a positive integer invoice_id.\nconst body = $input.first().json.body ?? {};\nconst id = body.invoice_id;\nif (!Number.isInteger(id) || id < 1) {\n  return [{ json: { valid: false, status_code: 400, reason: 'JSON body {\"invoice_id\": <positive integer>} is required' } }];\n}\nreturn [{ json: { valid: true, invoice_id: id } }];\n"
      }
    },
